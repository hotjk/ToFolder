#include <windows.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

1 24 "app.manifest"

IDI_APP         ICON "assets\\folder.ico"
IDI_FOLDER_OPEN ICON "assets\\folder2-open.ico"
IDI_FOLDER_FILL ICON "assets\\folder-fill.ico"

IDD_HOTKEY DIALOGEX 0, 0, 240, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hotkey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable hotkey", IDC_HOTKEY_ENABLE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 160, 12
    LTEXT           "Shortcut:", IDC_HOTKEY_LABEL, 12, 36, 80, 10
    EDITTEXT        IDC_HOTKEY_EDIT, 12, 50, 216, 14, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Click the box, then press a key combination.", IDC_HOTKEY_HINT,
                    12, 70, 216, 10
    DEFPUSHBUTTON   "OK", IDOK, 129, 88, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 183, 88, 50, 14
END
