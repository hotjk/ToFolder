#include <windows.h>
#include "resource.h"

#ifndef IDC_STATIC
#define IDC_STATIC (-1)
#endif

1 24 "app.manifest"

IDI_APP         ICON "assets\\folder.ico"
IDI_FOLDER_OPEN ICON "assets\\folder2-open.ico"
IDI_FOLDER_FILL ICON "assets\\folder-fill.ico"

IDD_HOTKEY DIALOGEX 0, 0, 240, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Hotkey"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable hotkey", IDC_HOTKEY_ENABLE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 160, 12
    LTEXT           "Shortcut:", IDC_HOTKEY_LABEL, 12, 36, 80, 10
    EDITTEXT        IDC_HOTKEY_EDIT, 12, 50, 216, 14, ES_READONLY | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Click the box, then press a key combination.", IDC_HOTKEY_HINT,
                    12, 70, 216, 10
    DEFPUSHBUTTON   "OK", IDOK, 129, 88, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 183, 88, 50, 14
END

IDD_FILTERS DIALOGEX 0, 0, 360, 228
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Filters"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    CONTROL         "Enable filters", IDC_FILTER_ENABLE, "Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP, 12, 10, 160, 12
    LTEXT           "Filters:", IDC_FILTER_LIST_LABEL, 12, 28, 120, 10
    LISTBOX         IDC_FILTER_LIST, 12, 40, 120, 140, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Name:", IDC_FILTER_NAME_LABEL, 148, 40, 80, 10
    EDITTEXT        IDC_FILTER_NAME, 148, 52, 196, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Extensions:", IDC_FILTER_EXT_LABEL, 148, 74, 120, 10
    EDITTEXT        IDC_FILTER_EXT, 148, 86, 196, 40, ES_MULTILINE | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Exts, or * / for files/folders.", IDC_FILTER_HINT, 148, 132, 196, 20
    PUSHBUTTON      "Add", IDC_FILTER_ADD, 148, 158, 60, 14
    PUSHBUTTON      "Update", IDC_FILTER_UPDATE, 214, 158, 60, 14
    PUSHBUTTON      "Remove", IDC_FILTER_REMOVE, 280, 158, 64, 14
    DEFPUSHBUTTON   "OK", IDOK, 248, 204, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 304, 204, 50, 14
END

IDD_HELP DIALOGEX 0, 0, 360, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Help"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_HELP_BODY, 12, 12, 336, 214,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 298, 236, 50, 14
END
